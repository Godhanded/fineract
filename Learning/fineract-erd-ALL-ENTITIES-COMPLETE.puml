  * id : BIGINT <<PK>>
  * account_no : VARCHAR(20)
  * display_name : VARCHAR(160)
  * status : INT
}
entity "Group" as group {
  * id : BIGINT <<PK>>
  * name : VARCHAR(100)
  * status : INT
}
entity "Office" as office {
  * id : BIGINT <<PK>>
  * name : VARCHAR(100)
}
entity "Staff" as staff {
  * id : BIGINT <<PK>>
  * firstname : VARCHAR(50)
  * lastname : VARCHAR(50)
  * is_loan_officer : BOOLEAN
}
entity "Fund" as fund {
  * id : BIGINT <<PK>>
  * name : VARCHAR(255)
}
entity "LoanProduct" as loan_product {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * short_name : VARCHAR(4)
  --
  ' Amount Configuration
  * principal_amount : DECIMAL(19,6)
  * min_principal_amount : DECIMAL(19,6)
  * max_principal_amount : DECIMAL(19,6)
  --
  ' Interest Configuration
  * nominal_interest_rate_per_period : DECIMAL(19,6)
  * annual_nominal_interest_rate : DECIMAL(19,6)
  * interest_method_enum : SMALLINT
    (0=DECLINING_BALANCE, 1=FLAT)
  * interest_calculated_in_period_enum : SMALLINT
  * interest_period_frequency_enum : SMALLINT
  --
  ' Repayment Configuration
  * number_of_repayments : SMALLINT
  * repay_every : SMALLINT
  * repayment_period_frequency_enum : SMALLINT
    (0=DAYS, 1=WEEKS, 2=MONTHS)
  * amortization_method_enum : SMALLINT
    (0=EQUAL_PRINCIPAL, 1=EQUAL_INSTALLMENTS)
  --
  ' Currency
  * currency_code : VARCHAR(3)
  * currency_digits : SMALLINT
  --
  ' Accounting
  * accounting_type : SMALLINT
    (1=CASH, 2=ACCRUAL_PERIODIC, 3=ACCRUAL_UPFRONT)
  --
  fund_id : BIGINT <<FK>>
}
entity "Loan" as loan {
  * id : BIGINT <<PK>>
  --
  * account_no : VARCHAR(20) <<unique>>
  external_id : VARCHAR(100) <<unique>>
  --
  ' References
  * client_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  group_id : BIGINT <<FK>>
  office_id : BIGINT <<FK>>
  loan_officer_id : BIGINT <<FK>>
  fund_id : BIGINT <<FK>>
  --
  ' Status & Type
  * loan_status_id : SMALLINT
    (100=SUBMITTED, 200=APPROVED,
     300=ACTIVE, 600=CLOSED,
     601=WRITTEN_OFF, 700=OVERPAID)
  * loan_type_enum : SMALLINT
    (1=INDIVIDUAL, 2=GROUP, 3=GLIM)
  loan_sub_status_id : SMALLINT
  --
  ' Loan Terms
  * principal_amount_proposed : DECIMAL(19,6)
  * principal_amount : DECIMAL(19,6)
  approved_principal : DECIMAL(19,6)
  net_disbursal_amount : DECIMAL(19,6)
  --
  ' Interest Terms
  nominal_interest_rate_per_period : DECIMAL(19,6)
  annual_nominal_interest_rate : DECIMAL(19,6)
  interest_method_enum : SMALLINT
  interest_calculated_in_period_enum : SMALLINT
  --
  ' Repayment Terms
  term_frequency : SMALLINT
  term_period_frequency_enum : SMALLINT
  number_of_repayments : SMALLINT
  repay_every : SMALLINT
  repayment_period_frequency_enum : SMALLINT
  amortization_method_enum : SMALLINT
  --
  ' Grace Periods
  grace_on_principal_periods : SMALLINT
  grace_on_interest_periods : SMALLINT
  grace_interest_free_periods : SMALLINT
  --
  ' Dates
  submittedon_date : DATE
  approvedon_date : DATE
  expected_disbursedon_date : DATE
  disbursedon_date : DATE
  expected_firstrepaymenton_date : DATE
  interest_calculated_from_date : DATE
  expected_maturedon_date : DATE
  maturedon_date : DATE
  closedon_date : DATE
  writtenoffon_date : DATE
  rescheduledon_date : DATE
  rejectedon_date : DATE
  withdrawnon_date : DATE
  --
  ' DERIVED BALANCES (Calculated & Cached)
  --
  ' Principal Tracking
  principal_disbursed_derived : DECIMAL(19,6)
  principal_repaid_derived : DECIMAL(19,6)
  principal_writtenoff_derived : DECIMAL(19,6)
  principal_outstanding_derived : DECIMAL(19,6)
  --
  ' Interest Tracking
  interest_charged_derived : DECIMAL(19,6)
  interest_repaid_derived : DECIMAL(19,6)
  interest_waived_derived : DECIMAL(19,6)
  interest_writtenoff_derived : DECIMAL(19,6)
  interest_outstanding_derived : DECIMAL(19,6)
  interest_recalculated_on : DATE
  --
  ' Fee Charges
  fee_charges_charged_derived : DECIMAL(19,6)
  fee_charges_repaid_derived : DECIMAL(19,6)
  fee_charges_waived_derived : DECIMAL(19,6)
  fee_charges_writtenoff_derived : DECIMAL(19,6)
  fee_charges_outstanding_derived : DECIMAL(19,6)
  --
  ' Penalty Charges
  penalty_charges_charged_derived : DECIMAL(19,6)
  penalty_charges_repaid_derived : DECIMAL(19,6)
  penalty_charges_waived_derived : DECIMAL(19,6)
  penalty_charges_writtenoff_derived : DECIMAL(19,6)
  penalty_charges_outstanding_derived : DECIMAL(19,6)
  --
  ' Total Tracking
  total_expected_repayment_derived : DECIMAL(19,6)
  total_repayment_derived : DECIMAL(19,6)
  total_expected_costofloan_derived : DECIMAL(19,6)
  total_costofloan_derived : DECIMAL(19,6)
  total_waived_derived : DECIMAL(19,6)
  total_writtenoff_derived : DECIMAL(19,6)
  total_outstanding_derived : DECIMAL(19,6)
  total_overpaid_derived : DECIMAL(19,6)
  --
  ' Currency
  * currency_code : VARCHAR(3)
  * currency_digits : SMALLINT
  currency_multiples_of : SMALLINT
  --
  ' Tolerance
  arrearstolerance_amount : DECIMAL(19,6)
}
entity "LoanTransaction" as loan_transaction {
  * id : BIGINT <<PK>>
  --
  * loan_id : BIGINT <<FK>>
  * office_id : BIGINT <<FK>>
  --
  ' Transaction Details
  * transaction_type_enum : SMALLINT
    (1=DISBURSEMENT, 2=REPAYMENT,
     3=CONTRA, 4=WAIVE_INTEREST,
     5=REPAYMENT_AT_DISBURSEMENT,
     6=WRITEOFF, 7=MARKED_FOR_RESCHEDULING,
     8=RECOVERY_REPAYMENT, 9=WAIVE_CHARGES,
     10=ACCRUAL, 12=INITIATE_TRANSFER,
     13=APPROVE_TRANSFER, 14=WITHDRAW_TRANSFER,
     15=REJECT_TRANSFER, 16=REFUND,
     17=CHARGE_PAYMENT, 18=REFUND_FOR_ACTIVE_LOAN,
     19=INCOME_POSTING, 20=CREDIT_BALANCE_REFUND,
     21=MERCHANT_ISSUED_REFUND, 22=PAYOUT_REFUND,
     23=GOODWILL_CREDIT, 24=CHARGE_ADJUSTMENT,
     25=CHARGE_OFF, 26=DOWN_PAYMENT,
     27=REAGE, 28=REAMORTIZE,
     29=CHARGEBACK, ...)
  --
  * transaction_date : DATE
  submitted_on_date : DATE
  --
  * amount : DECIMAL(19,6)
  --
  ' Allocation Breakdown
  principal_portion_derived : DECIMAL(19,6)
  interest_portion_derived : DECIMAL(19,6)
  fee_charges_portion_derived : DECIMAL(19,6)
  penalty_charges_portion_derived : DECIMAL(19,6)
  overpayment_portion_derived : DECIMAL(19,6)
  unrecognized_income_portion : DECIMAL(19,6)
  --
  outstanding_loan_balance_derived : DECIMAL(19,6)
  --
  ' Status & References
  * is_reversed : BOOLEAN
  manually_adjusted_or_reversed : BOOLEAN
  external_id : VARCHAR(100) <<unique>>
  reversal_external_id : VARCHAR(100)
  reversed_on_date : DATE
  --
  ' Payment Details
  payment_detail_id : BIGINT <<FK>>
}
entity "LoanRepaymentScheduleInstallment" as loan_schedule {
  * id : BIGINT <<PK>>
  --
  * loan_id : BIGINT <<FK>>
  * installment : SMALLINT
  --
  ' Period Dates
  * fromdate : DATE
  * duedate : DATE
  obligations_met_on_date : DATE
  --
  ' Principal Component
  principal : DECIMAL(19,6)
  principal_completed_derived : DECIMAL(19,6)
  principal_writtenoff_derived : DECIMAL(19,6)
  --
  ' Interest Component
  interest : DECIMAL(19,6)
  interest_completed_derived : DECIMAL(19,6)
  interest_writtenoff_derived : DECIMAL(19,6)
  interest_waived_derived : DECIMAL(19,6)
  accrual_interest_derived : DECIMAL(19,6)
  --
  ' Fee Charges
  fee_charges_amount : DECIMAL(19,6)
  fee_charges_completed_derived : DECIMAL(19,6)
  fee_charges_writtenoff_derived : DECIMAL(19,6)
  fee_charges_waived_derived : DECIMAL(19,6)
  accrual_fee_charges_derived : DECIMAL(19,6)
  --
  ' Penalty Charges
  penalty_charges_amount : DECIMAL(19,6)
  penalty_charges_completed_derived : DECIMAL(19,6)
  penalty_charges_writtenoff_derived : DECIMAL(19,6)
  penalty_charges_waived_derived : DECIMAL(19,6)
  accrual_penalty_charges_derived : DECIMAL(19,6)
  --
  ' Status
  * completed_derived : BOOLEAN
  recalculated_interest_component : BOOLEAN
}
entity "Charge" as charge {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * charge_applies_to_enum : SMALLINT
    (1=LOAN, 2=SAVINGS, 3=CLIENT, 4=SHARES)
  * charge_time_enum : SMALLINT
    (1=DISBURSEMENT, 2=SPECIFIED_DUE_DATE,
     3=INSTALLMENT_FEE, 4=OVERDUE_INSTALLMENT,
     5=DISBURSEMENT_PAID_WITH_REPAYMENT,
     6=OVERDUE_ON_MATURITY, 7=UPFRONT,
     8=TRANCHE_DISBURSEMENT)
  * charge_calculation_enum : SMALLINT
    (1=FLAT, 2=PERCENT_OF_AMOUNT,
     3=PERCENT_OF_AMOUNT_AND_INTEREST,
     4=PERCENT_OF_INTEREST,
     5=PERCENT_OF_DISBURSEMENT_AMOUNT)
  * charge_payment_mode_enum : SMALLINT
    (0=REGULAR, 1=ACCOUNT_TRANSFER)
  --
  * amount : DECIMAL(19,6)
  * currency_code : VARCHAR(3)
  --
  * is_penalty : BOOLEAN
  * is_active : BOOLEAN
  * is_deleted : BOOLEAN
  --
  min_cap : DECIMAL(19,6)
  max_cap : DECIMAL(19,6)
  fee_on_day : INT
  fee_on_month : INT
  fee_interval : INT
  fee_frequency : SMALLINT
}
entity "LoanCharge" as loan_charge {
  * id : BIGINT <<PK>>
  --
  * loan_id : BIGINT <<FK>>
  * charge_id : BIGINT <<FK>>
  --
  * is_penalty : BOOLEAN
  * charge_time_enum : SMALLINT
  * charge_calculation_enum : SMALLINT
  * charge_payment_mode_enum : SMALLINT
  --
  * amount : DECIMAL(19,6)
  amount_percentage_apportioned_to : DECIMAL(19,6)
  --
  ' Derived Amounts
  amount_paid_derived : DECIMAL(19,6)
  amount_waived_derived : DECIMAL(19,6)
  amount_writtenoff_derived : DECIMAL(19,6)
  amount_outstanding_derived : DECIMAL(19,6)
  amount_or_percentage : DECIMAL(19,6)
  --
  ' Dates
  charge_time_enum : SMALLINT
  due_for_collection_as_of_date : DATE
  charge_due_date : DATE
  charge_applied_date : DATE
