@startuml Apache Fineract Complete ERD

' ============================================
' APACHE FINERACT - COMPLETE ENTITY RELATIONSHIP DIAGRAM
' ============================================

skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80

' ============================================
' ORGANIZATIONAL ENTITIES
' ============================================

entity "Office" as office {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * parent_id : BIGINT <<FK>>
  * hierarchy : VARCHAR(100)
  * opening_date : DATE
  external_id : VARCHAR(100)
}

entity "Staff" as staff {
  * id : BIGINT <<PK>>
  --
  * office_id : BIGINT <<FK>>
  * firstname : VARCHAR(50)
  * lastname : VARCHAR(50)
  * is_loan_officer : BOOLEAN
  * is_active : BOOLEAN
  mobile_no : VARCHAR(50)
  email : VARCHAR(100)
}

' ============================================
' CLIENT & GROUP ENTITIES
' ============================================

entity "Client" as client {
  * id : BIGINT <<PK>>
  --
  * account_no : VARCHAR(20) <<unique>>
  * office_id : BIGINT <<FK>>
  * status_enum : INT
  * legal_form_enum : INT
  staff_id : BIGINT <<FK>>
  external_id : VARCHAR(100) <<unique>>
  --
  ' Personal Information
  firstname : VARCHAR(50)
  middlename : VARCHAR(50)
  lastname : VARCHAR(50)
  fullname : VARCHAR(160)
  * display_name : VARCHAR(160)
  date_of_birth : DATE
  --
  ' Contact
  mobile_no : VARCHAR(50) <<unique>>
  email_address : VARCHAR(150) <<unique>>
  --
  ' Classification
  gender_cv_id : BIGINT <<FK>>
  client_type_cv_id : BIGINT <<FK>>
  client_classification_cv_id : BIGINT <<FK>>
  --
  ' Lifecycle
  activation_date : DATE
  submittedon_date : DATE
  closedon_date : DATE
  rejectedon_date : DATE
  withdrawnon_date : DATE
  --
  ' Savings Link
  default_savings_product : BIGINT <<FK>>
  default_savings_account : BIGINT <<FK>>
  --
  ' Image
  image_id : BIGINT <<FK>>
}

entity "ClientIdentifier" as client_identifier {
  * id : BIGINT <<PK>>
  --
  * client_id : BIGINT <<FK>>
  * document_type : BIGINT <<FK>>
  * document_key : VARCHAR(1000)
  status : INT
  description : VARCHAR(1000)
}

entity "ClientAddress" as client_address {
  * id : BIGINT <<PK>>
  --
  * client_id : BIGINT <<FK>>
  * address_id : BIGINT <<FK>>
  * address_type_id : BIGINT <<FK>>
  is_active : BOOLEAN
}

entity "ClientFamilyMembers" as client_family {
  * id : BIGINT <<PK>>
  --
  * client_id : BIGINT <<FK>>
  firstname : VARCHAR(100)
  middlename : VARCHAR(100)
  lastname : VARCHAR(100)
  qualification : VARCHAR(100)
  relationship_cv_id : BIGINT <<FK>>
  gender_cv_id : BIGINT <<FK>>
  date_of_birth : DATE
  age : BIGINT
  is_dependent : BOOLEAN
}

entity "Group" as group {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100) <<unique>>
  * account_no : VARCHAR(20)
  * office_id : BIGINT <<FK>>
  * status_enum : INT
  staff_id : BIGINT <<FK>>
  parent_id : BIGINT <<FK>>
  level_id : INT <<FK>>
  external_id : VARCHAR(100) <<unique>>
  hierarchy : VARCHAR(100)
  activation_date : DATE
  submittedon_date : DATE
}

entity "GroupLevel" as group_level {
  * id : INT <<PK>>
  --
  * level_name : VARCHAR(100)
  parent_id : INT <<FK>>
  super_parent : BOOLEAN
  recursable : BOOLEAN
  can_have_clients : BOOLEAN
}

entity "GroupClient" as group_client {
  * group_id : BIGINT <<PK,FK>>
  * client_id : BIGINT <<PK,FK>>
}

' ============================================
' LOAN ENTITIES
' ============================================

entity "LoanProduct" as loan_product {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * short_name : VARCHAR(4)
  * currency_code : VARCHAR(3)
  * currency_digits : SMALLINT
  * principal_amount : DECIMAL(19,6)
  * min_principal_amount : DECIMAL(19,6)
  * max_principal_amount : DECIMAL(19,6)
  * nominal_interest_rate_per_period : DECIMAL(19,6)
  * interest_period_frequency_enum : SMALLINT
  * annual_nominal_interest_rate : DECIMAL(19,6)
  * interest_method_enum : SMALLINT
  * interest_calculated_in_period_enum : SMALLINT
  * number_of_repayments : SMALLINT
  * repay_every : SMALLINT
  * repayment_period_frequency_enum : SMALLINT
  * amortization_method_enum : SMALLINT
  * accounting_type : SMALLINT
  fund_id : BIGINT <<FK>>
}

entity "Loan" as loan {
  * id : BIGINT <<PK>>
  --
  * account_no : VARCHAR(20) <<unique>>
  * client_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  * loan_status_id : SMALLINT
  * loan_type_enum : SMALLINT
  external_id : VARCHAR(100) <<unique>>
  --
  ' Officers & Office
  loan_officer_id : BIGINT <<FK>>
  office_id : BIGINT <<FK>>
  group_id : BIGINT <<FK>>
  fund_id : BIGINT <<FK>>
  --
  ' Loan Terms
  * principal_amount_proposed : DECIMAL(19,6)
  * principal_amount : DECIMAL(19,6)
  approved_principal : DECIMAL(19,6)
  net_disbursal_amount : DECIMAL(19,6)
  * currency_code : VARCHAR(3)
  * currency_digits : SMALLINT
  --
  ' Interest
  nominal_interest_rate_per_period : DECIMAL(19,6)
  annual_nominal_interest_rate : DECIMAL(19,6)
  interest_method_enum : SMALLINT
  interest_calculated_in_period_enum : SMALLINT
  --
  ' Repayment
  term_frequency : SMALLINT
  term_period_frequency_enum : SMALLINT
  number_of_repayments : SMALLINT
  repay_every : SMALLINT
  repayment_period_frequency_enum : SMALLINT
  amortization_method_enum : SMALLINT
  --
  ' Dates
  submittedon_date : DATE
  approvedon_date : DATE
  expected_disbursedon_date : DATE
  disbursedon_date : DATE
  expected_firstrepaymenton_date : DATE
  expected_maturedon_date : DATE
  maturedon_date : DATE
  closedon_date : DATE
  writtenoffon_date : DATE
  --
  ' Derived Balances (Calculated)
  principal_disbursed_derived : DECIMAL(19,6)
  principal_repaid_derived : DECIMAL(19,6)
  principal_writtenoff_derived : DECIMAL(19,6)
  principal_outstanding_derived : DECIMAL(19,6)
  interest_charged_derived : DECIMAL(19,6)
  interest_repaid_derived : DECIMAL(19,6)
  interest_waived_derived : DECIMAL(19,6)
  interest_writtenoff_derived : DECIMAL(19,6)
  interest_outstanding_derived : DECIMAL(19,6)
  fee_charges_charged_derived : DECIMAL(19,6)
  fee_charges_repaid_derived : DECIMAL(19,6)
  fee_charges_outstanding_derived : DECIMAL(19,6)
  penalty_charges_charged_derived : DECIMAL(19,6)
  penalty_charges_repaid_derived : DECIMAL(19,6)
  penalty_charges_outstanding_derived : DECIMAL(19,6)
  total_expected_repayment_derived : DECIMAL(19,6)
  total_repayment_derived : DECIMAL(19,6)
  total_outstanding_derived : DECIMAL(19,6)
  total_overpaid_derived : DECIMAL(19,6)
}

entity "LoanTransaction" as loan_transaction {
  * id : BIGINT <<PK>>
  --
  * loan_id : BIGINT <<FK>>
  * office_id : BIGINT <<FK>>
  * transaction_type_enum : SMALLINT
  * transaction_date : DATE
  * amount : DECIMAL(19,6)
  submitted_on_date : DATE
  is_reversed : BOOLEAN
  external_id : VARCHAR(100) <<unique>>
  payment_detail_id : BIGINT <<FK>>
  --
  ' Allocation Portions
  principal_portion_derived : DECIMAL(19,6)
  interest_portion_derived : DECIMAL(19,6)
  fee_charges_portion_derived : DECIMAL(19,6)
  penalty_charges_portion_derived : DECIMAL(19,6)
  overpayment_portion_derived : DECIMAL(19,6)
  unrecognized_income_portion : DECIMAL(19,6)
  outstanding_loan_balance_derived : DECIMAL(19,6)
}

entity "LoanRepaymentScheduleInstallment" as loan_schedule {
  * id : BIGINT <<PK>>
  --
  * loan_id : BIGINT <<FK>>
  * installment : SMALLINT
  * fromdate : DATE
  * duedate : DATE
  --
  ' Principal
  principal : DECIMAL(19,6)
  principal_completed_derived : DECIMAL(19,6)
  principal_writtenoff_derived : DECIMAL(19,6)
  --
  ' Interest
  interest : DECIMAL(19,6)
  interest_completed_derived : DECIMAL(19,6)
  interest_writtenoff_derived : DECIMAL(19,6)
  interest_waived_derived : DECIMAL(19,6)
  --
  ' Charges
  fee_charges_amount : DECIMAL(19,6)
  fee_charges_completed_derived : DECIMAL(19,6)
  fee_charges_writtenoff_derived : DECIMAL(19,6)
  fee_charges_waived_derived : DECIMAL(19,6)
  penalty_charges_amount : DECIMAL(19,6)
  penalty_charges_completed_derived : DECIMAL(19,6)
  penalty_charges_writtenoff_derived : DECIMAL(19,6)
  penalty_charges_waived_derived : DECIMAL(19,6)
  --
  completed_derived : BOOLEAN
  obligations_met_on_date : DATE
  recalculated_interest_component : BOOLEAN
}

entity "LoanCharge" as loan_charge {
  * id : BIGINT <<PK>>
  --
  * loan_id : BIGINT <<FK>>
  * charge_id : BIGINT <<FK>>
  * is_penalty : BOOLEAN
  * charge_time_enum : SMALLINT
  * charge_calculation_enum : SMALLINT
  * charge_payment_mode_enum : SMALLINT
  * amount : DECIMAL(19,6)
  due_for_collection_as_of_date : DATE
  --
  ' Derived Amounts
  amount_paid_derived : DECIMAL(19,6)
  amount_waived_derived : DECIMAL(19,6)
  amount_writtenoff_derived : DECIMAL(19,6)
  amount_outstanding_derived : DECIMAL(19,6)
  --
  is_paid_derived : BOOLEAN
  waived : BOOLEAN
  is_active : BOOLEAN
}

entity "LoanCollateral" as loan_collateral {
  * id : BIGINT <<PK>>
  --
  * loan_id : BIGINT <<FK>>
  * type_cv_id : BIGINT <<FK>>
  value : DECIMAL(19,6)
  description : VARCHAR(500)
}

entity "Guarantor" as guarantor {
  * id : BIGINT <<PK>>
  --
  * loan_id : BIGINT <<FK>>
  client_reln_cv_id : BIGINT <<FK>>
  entity_id : BIGINT
  guarantor_type_enum : SMALLINT
  firstname : VARCHAR(50)
  lastname : VARCHAR(50)
  address_line_1 : VARCHAR(500)
  mobile_number : VARCHAR(50)
  amount : DECIMAL(19,6)
}

' ============================================
' SAVINGS ENTITIES
' ============================================

entity "SavingsProduct" as savings_product {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * short_name : VARCHAR(4)
  * currency_code : VARCHAR(3)
  * currency_digits : SMALLINT
  * nominal_annual_interest_rate : DECIMAL(19,6)
  * interest_compounding_period_enum : SMALLINT
  * interest_posting_period_enum : SMALLINT
  * interest_calculation_type_enum : SMALLINT
  * interest_calculation_days_in_year_type : SMALLINT
  * accounting_type : SMALLINT
  min_required_opening_balance : DECIMAL(19,6)
  lockin_period_frequency : DECIMAL(19,6)
  withdrawal_fee_for_transfer : BOOLEAN
  allow_overdraft : BOOLEAN
  overdraft_limit : DECIMAL(19,6)
  nominal_annual_interest_rate_overdraft : DECIMAL(19,6)
  min_overdraft_for_interest_calculation : DECIMAL(19,6)
}

entity "SavingsAccount" as savings_account {
  * id : BIGINT <<PK>>
  --
  * account_no : VARCHAR(20) <<unique>>
  * client_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  * status_enum : SMALLINT
  * account_type_enum : SMALLINT
  external_id : VARCHAR(100) <<unique>>
  --
  ' Officers & Office
  field_officer_id : BIGINT <<FK>>
  office_id : BIGINT <<FK>>
  group_id : BIGINT <<FK>>
  --
  ' Interest Configuration
  nominal_annual_interest_rate : DECIMAL(19,6)
  interest_compounding_period_enum : SMALLINT
  interest_posting_period_enum : SMALLINT
  interest_calculation_type_enum : SMALLINT
  interest_calculation_days_in_year_type : SMALLINT
  --
  ' Balance & Constraints
  min_required_opening_balance : DECIMAL(19,6)
  min_required_balance : DECIMAL(19,6)
  enforce_min_required_balance : BOOLEAN
  nominal_annual_interest_rate_overdraft : DECIMAL(19,6)
  overdraft_limit : DECIMAL(19,6)
  allow_overdraft : BOOLEAN
  --
  ' Derived Balances
  account_balance_derived : DECIMAL(19,6)
  total_deposits_derived : DECIMAL(19,6)
  total_withdrawals_derived : DECIMAL(19,6)
  total_interest_earned_derived : DECIMAL(19,6)
  total_interest_posted_derived : DECIMAL(19,6)
  total_withdrawal_fees_derived : DECIMAL(19,6)
  total_fees_charge_derived : DECIMAL(19,6)
  total_penalty_charge_derived : DECIMAL(19,6)
  total_annual_fees_derived : DECIMAL(19,6)
  total_overdraft_interest_derived : DECIMAL(19,6)
  --
  ' Dates
  submittedon_date : DATE
  approvedon_date : DATE
  activatedon_date : DATE
  closedon_date : DATE
  lockedin_until_date_derived : DATE
  --
  ' Sub-status
  sub_status_enum : SMALLINT
  deposit_type_enum : SMALLINT
}

entity "SavingsAccountTransaction" as savings_transaction {
  * id : BIGINT <<PK>>
  --
  * savings_account_id : BIGINT <<FK>>
  * office_id : BIGINT <<FK>>
  * transaction_type_enum : SMALLINT
  * transaction_date : DATE
  * amount : DECIMAL(19,6)
  submitted_on_date : DATE
  is_reversed : BOOLEAN
  payment_detail_id : BIGINT <<FK>>
  --
  ' Balance Tracking
  running_balance_derived : DECIMAL(19,6)
  cumulative_balance_derived : DECIMAL(19,6)
  overdraft_amount_derived : DECIMAL(19,6)
}

entity "SavingsAccountCharge" as savings_charge {
  * id : BIGINT <<PK>>
  --
  * savings_account_id : BIGINT <<FK>>
  * charge_id : BIGINT <<FK>>
  * is_penalty : BOOLEAN
  * charge_time_enum : SMALLINT
  * charge_calculation_enum : SMALLINT
  * amount : DECIMAL(19,6)
  due_for_collection_as_of_date : DATE
  --
  ' Derived Amounts
  amount_paid_derived : DECIMAL(19,6)
  amount_waived_derived : DECIMAL(19,6)
  amount_writtenoff_derived : DECIMAL(19,6)
  amount_outstanding_derived : DECIMAL(19,6)
  --
  is_paid_derived : BOOLEAN
  waived : BOOLEAN
  is_active : BOOLEAN
}

entity "FixedDepositAccount" as fixed_deposit {
  * id : BIGINT <<PK,FK>>
  --
  * deposit_amount : DECIMAL(19,6)
  * maturity_amount : DECIMAL(19,6)
  * maturity_date : DATE
  on_account_closure_id : BIGINT <<FK>>
  transfer_to_savings_account_id : BIGINT <<FK>>
}

entity "RecurringDepositAccount" as recurring_deposit {
  * id : BIGINT <<PK,FK>>
  --
  * deposit_amount : DECIMAL(19,6)
  * total_overdue_amount : DECIMAL(19,6)
  * no_of_overdue_installments : INT
  * maturity_amount : DECIMAL(19,6)
  * maturity_date : DATE
  on_account_closure_id : BIGINT <<FK>>
  transfer_to_savings_account_id : BIGINT <<FK>>
}

' ============================================
' CHARGE/FEE ENTITIES
' ============================================

entity "Charge" as charge {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * currency_code : VARCHAR(3)
  * charge_applies_to_enum : SMALLINT
  * charge_time_enum : SMALLINT
  * charge_calculation_enum : SMALLINT
  * charge_payment_mode_enum : SMALLINT
  * amount : DECIMAL(19,6)
  * is_penalty : BOOLEAN
  * is_active : BOOLEAN
  * is_deleted : BOOLEAN
  min_cap : DECIMAL(19,6)
  max_cap : DECIMAL(19,6)
  fee_on_day : INT
  fee_on_month : INT
  fee_interval : INT
  fee_frequency : SMALLINT
}

entity "Fund" as fund {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(255)
  external_id : VARCHAR(100)
}

' ============================================
' ACCOUNTING ENTITIES
' ============================================

entity "GLAccount" as gl_account {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(200)
  * gl_code : VARCHAR(45) <<unique>>
  * account_usage : SMALLINT
  * classification_enum : SMALLINT
  parent_id : BIGINT <<FK>>
  * disabled : BOOLEAN
  * manual_journal_entries_allowed : BOOLEAN
  description : VARCHAR(500)
  tag_id : BIGINT <<FK>>
}

entity "JournalEntry" as journal_entry {
  * id : BIGINT <<PK>>
  --
  * glaccount_id : BIGINT <<FK>>
  * office_id : BIGINT <<FK>>
  * type_enum : SMALLINT
  * transaction_date : DATE
  * amount : DECIMAL(19,6)
  * currency_code : VARCHAR(3)
  submitted_on_date : DATE
  description : VARCHAR(500)
  entity_type_enum : SMALLINT
  entity_id : BIGINT
  transaction_id : VARCHAR(50)
  --
  ' Source Tracking
  loan_transaction_id : BIGINT <<FK>>
  savings_transaction_id : BIGINT <<FK>>
  client_transaction_id : BIGINT <<FK>>
  share_transaction_id : BIGINT <<FK>>
  --
  * reversed : BOOLEAN
  manual_entry : BOOLEAN
  payment_details_id : BIGINT <<FK>>
}

entity "ProductToGLAccountMapping" as product_gl_mapping {
  * id : BIGINT <<PK>>
  --
  * glaccount_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  * product_type : SMALLINT
  * financial_account_type : SMALLINT
  payment_type : BIGINT <<FK>>
  charge_id : BIGINT <<FK>>
}

entity "FinancialActivityAccount" as financial_activity {
  * id : BIGINT <<PK>>
  --
  * glaccount_id : BIGINT <<FK>>
  * financial_activity_type : SMALLINT
}

entity "GLClosure" as gl_closure {
  * id : BIGINT <<PK>>
  --
  * office_id : BIGINT <<FK>>
  * closing_date : DATE
  is_deleted : BOOLEAN
  comments : VARCHAR(500)
}

entity "AccountingRule" as accounting_rule {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100) <<unique>>
  * office_id : BIGINT <<FK>>
  * debit_account_id : BIGINT <<FK>>
  * credit_account_id : BIGINT <<FK>>
  description : VARCHAR(500)
  system_defined : BOOLEAN
  allow_multiple_debit_entries : BOOLEAN
  allow_multiple_credit_entries : BOOLEAN
}

' ============================================
' INFRASTRUCTURE ENTITIES
' ============================================

entity "Code" as code {
  * id : BIGINT <<PK>>
  --
  * code_name : VARCHAR(100) <<unique>>
  is_system_defined : BOOLEAN
}

entity "CodeValue" as code_value {
  * id : BIGINT <<PK>>
  --
  * code_id : BIGINT <<FK>>
  * code_value : VARCHAR(100)
  * order_position : INT
  code_score : INT
  is_active : BOOLEAN
  is_mandatory : BOOLEAN
}

entity "PaymentDetail" as payment_detail {
  * id : BIGINT <<PK>>
  --
  * payment_type_id : BIGINT <<FK>>
  account_number : VARCHAR(100)
  check_number : VARCHAR(100)
  receipt_number : VARCHAR(100)
  bank_number : VARCHAR(100)
  routing_code : VARCHAR(100)
}

entity "PaymentType" as payment_type {
  * id : BIGINT <<PK>>
  --
  * value : VARCHAR(100)
  description : VARCHAR(500)
  is_cash_payment : BOOLEAN
  order_position : INT
}

entity "Calendar" as calendar {
  * id : BIGINT <<PK>>
  --
  * title : VARCHAR(50)
  * entity_type_enum : SMALLINT
  * entity_id : BIGINT
  * start_date : DATE
  * end_date : DATE
  * duration : INT
  * calendar_type_enum : SMALLINT
  * repeating : BOOLEAN
  * recurrence : VARCHAR(100)
  remind_by_enum : SMALLINT
  first_reminder : INT
  second_reminder : INT
  location : VARCHAR(100)
}

entity "Image" as image {
  * id : BIGINT <<PK>>
  --
  * location : VARCHAR(500)
  * storage_type_enum : SMALLINT
  image : LONGBLOB
}

entity "CommandSource" as command_source {
  * id : BIGINT <<PK>>
  --
  * action_name : VARCHAR(100)
  * entity_name : VARCHAR(100)
  * office_id : BIGINT <<FK>>
  resource_id : BIGINT
  * api_get_url : VARCHAR(100)
  resource_get_url : VARCHAR(100)
  command_as_json : TEXT
  * maker_id : BIGINT <<FK>>
  * made_on_date : DATETIME
  checker_id : BIGINT <<FK>>
  checked_on_date : DATETIME
  * processing_result_enum : SMALLINT
  result : TEXT
  transaction_id : VARCHAR(100)
  idempotency_key : VARCHAR(50)
}

